{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tiernotfall-Kontakte",
  "type": "object",
  "required": ["meta", "contacts"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["last_full_review", "review_interval_months"],
      "properties": {
        "title": { "type": "string" },
        "maintainer": { "type": "string" },
        "region_focus": { "type": "array", "items": { "type": "string" } },
        "last_full_review": { "type": "string", "format": "date" },
        "review_interval_months": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "org_type", "scope", "verified_date", "source", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Stabiler Referenzschlüssel; wird im HTML via data-contact verwendet. Niemals ändern, nur deprecaten."
          },
          "name": { "type": "string", "minLength": 3 },
          "category": {
            "enum": ["notruf", "fundtier", "register", "tiermedizin", "vergiftung", "wildtier", "tierheim", "tierschutzverstoss", "tierrettung", "totfund", "information"]
          },
          "org_type": {
            "enum": ["amtlich", "gemeinnuetzig", "privat_kostenpflichtig"],
            "description": "Wird als Badge gerendert; privat_kostenpflichtig MUSS sichtbar gekennzeichnet werden."
          },
          "phone": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["display", "e164"],
                "additionalProperties": false,
                "properties": {
                  "display": { "type": "string", "description": "Lesbare Formatierung für die Anzeige" },
                  "e164": {
                    "type": "string",
                    "pattern": "^(\\+[0-9]{6,15}|11[02])$",
                    "description": "Für den tel:-Link. Ausnahme: nationale Kurzwahlen 110/112."
                  }
                }
              }
            ]
          },
          "availability": { "type": ["string", "null"], "description": "Erreichbarkeit als Freitext, z. B. '24/7' oder 'Mo–Fr 9–16 Uhr'" },
          "scope": { "type": "string", "description": "Räumliche Zuständigkeit, z. B. 'Berlin', 'bundesweit'" },
          "address": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "note": { "type": ["string", "null"], "description": "Kurznotiz für die Kontaktkarte; Warnhinweise hier unterbringen" },
          "url": { "type": ["string", "null"], "format": "uri" },
          "verified_date": {
            "type": "string",
            "format": "date",
            "description": "Datum der letzten Prüfung der Angaben. Seite rendert min(verified_date) als 'Stand'."
          },
          "source": { "type": "string", "description": "Quelle der Verifikation (URL oder Beschreibung)" },
          "status": {
            "enum": ["active", "verify_before_launch", "deprecated"],
            "description": "verify_before_launch: Eintrag unvollständig/unbestätigt – vor Go-Live prüfen, bis dahin NICHT rendern oder mit Vorbehalt rendern. deprecated: nicht mehr rendern, ID bleibt reserviert."
          },
          "todo": { "type": "string", "description": "Offene Prüfaufgabe für den Review-Workflow" }
        }
      }
    }
  }
}
